<mxfile host="app.diagrams.net">
  <diagram name="ELT pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n0" value="&lt;b&gt;public sources&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;openmoney.md  ·  depozitar.statistica.md&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#b45309;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;verticalAlign=middle;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="430" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;BrowserPool  (Playwright Chromium)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;one page per host, throttled and retried,&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;rendered HTML captured as fetched&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#3730a3;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;source_data&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;one row per request: url, status, body,&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;fetched_at, job_id  ·  never edited&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;build_company&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;reads the latest body per resource,&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;parses and cleans into typed records&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#3730a3;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="500" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;transformed_data&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;+ company_people, financial_statements,&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;financial_line_items  ·  upserted by IDNO&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="430" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;neo4j&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;Company and Person nodes,&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size: 11px&#x27;&gt;FOUNDER / ADMINISTRATOR edges&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="826" width="430" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="raw HTML and JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1d4ed8;strokeWidth=1.7;fontSize=11;fontColor=#1d4ed8;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n0" target="n1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e1" value="stored verbatim, before anything reads it" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1d4ed8;strokeWidth=1.7;fontSize=11;fontColor=#1d4ed8;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="latest body per resource" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1d4ed8;strokeWidth=1.7;fontSize=11;fontColor=#1d4ed8;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="typed records, one company at a time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1d4ed8;strokeWidth=1.7;fontSize=11;fontColor=#1d4ed8;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="projected after the postgres commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1d4ed8;strokeWidth=1.7;fontSize=11;fontColor=#1d4ed8;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t0" value="Each job runs as a background asyncio task: POST /scrape/jobs/{id}/cancel stops it mid-flight." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="900" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="Postgres holds the truth, so POST /scrape/reproject rebuilds the whole neo4j graph from the tables alone." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="900" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
