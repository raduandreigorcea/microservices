# Copy to .env and set real passwords before running the stack.

COMPOSE_PROJECT_NAME=microservices-web-app

# --- PostgreSQL -------------------------------------------------------------
# Superuser. Used for bootstrap and migrations only.
POSTGRES_DB=microservices
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# One role per data-owning service. Created by db/init on first start.
USER_SERVICE_DB_USER=user_service_app
USER_SERVICE_DB_PASSWORD=change_me_user_service
SCRAPER_SERVICE_DB_USER=scraper_service_app
SCRAPER_SERVICE_DB_PASSWORD=change_me_scraper_service

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# --- Neo4j ------------------------------------------------------------------
# The relationship graph. Postgres stays the source of truth; this is a
# projection the scraper rewrites after every transform, and
# POST /scrape/reproject rebuilds from scratch. Leave NEO4J_PASSWORD empty to
# run without it: the graph endpoint falls back to the one-hop SQL query.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_DATABASE=neo4j
NEO4J_BOLT_PORT=7687
# The neo4j browser console, at http://localhost:7474
NEO4J_HTTP_PORT=7474
NEO4J_HEAP=512m

# --- Auth -------------------------------------------------------------------
# At least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_long_random_value_at_least_32_bytes

# --- Google sign-in ---------------------------------------------------------
# Google Cloud Console > Credentials > OAuth client ID > Web application.
# Add http://localhost:8002/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser lands once login succeeds. The frontend reads the token
# pair out of the URL fragment. Leave empty to get the JSON body instead.
LOGIN_SUCCESS_REDIRECT=http://localhost:5173/

# --- Scraper ----------------------------------------------------------------
# Seconds between two requests to the same source. Lower it at your own risk:
# the statistics depository starts answering 403 when pushed.
SCRAPER_MIN_INTERVAL_SECONDS=1.0
# Chromium tabs open at once. Each one costs memory.
SCRAPER_BROWSER_MAX_PAGES=2
# Keep the rendered DOM next to the JSON. Turn off for a faster, smaller crawl.
SCRAPER_CAPTURE_RENDERED_HTML=true
# INFO narrates each request and each page the browser opens. WARNING leaves
# only the failures.
SCRAPER_LOG_LEVEL=INFO

# --- Host ports (dev only) --------------------------------------------------
GATEWAY_PORT=8000
APP_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
SCRAPER_SERVICE_PORT=8003
FRONTEND_PORT=5173
